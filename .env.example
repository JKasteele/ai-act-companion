# =====================================================================
#  AI Act Companion - example configuration
#  Copy to .env. The rule-based core and guided workspace need no model.
#  These settings enable optional drafting and live evidence investigation.
# =====================================================================

# Which LLM provider the AI layer uses: "ollama" | "manual" | "replay" | "anthropic" | "none"
#   ollama    -> local prefill/narrative and workspace evidence investigation
#   manual    -> the app generates a prompt you paste into your own LLM session
#   replay    -> sandbox mode: no model, no egress, pre-recorded drafts
#   anthropic -> hosted Claude, guarded by a small spend cap (see below)
#   none      -> AI layer off (rule-based only)
LLM_PROVIDER=ollama

# --- Ollama (local) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:32b

# --- Anthropic (hosted, only if LLM_PROVIDER=anthropic) ---
# Note: a Claude Max/Pro subscription is NOT an API backend. For API use you
# need a separate, separately billed API key. Never commit a real key.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5
# Spend guard (classic drafting falls back to labelled replay; workspace live
# requests stop explicitly when unavailable, with the guided mode still usable):
# AI_BUDGET_USD=4.00
# AI_DAILY_CALLS=25
# AI_CALLS_PER_IP_DAY=8
